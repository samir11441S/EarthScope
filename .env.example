# Ask Earth works with no configuration: a free, keyless open AI model (GPT-OSS via Pollinations),
# grounded in EarthScope's data, with the offline rule-based guide as fallback.

# Optional — use Claude instead (best quality, paid):
ANTHROPIC_API_KEY=
# ASK_EARTH_MODEL=claude-opus-5-5
# ASK_EARTH_EFFORT=low          # low | medium | high | xhigh | max

# Optional — use another free OpenAI-compatible service instead of Pollinations, e.g. Groq:
# ASK_EARTH_OPENAI_URL=https://api.groq.com/openai/v1/chat/completions
# ASK_EARTH_OPENAI_KEY=your-free-key
# ASK_EARTH_OPENAI_MODEL=openai/gpt-oss-20b
# ASK_EARTH_OPENAI_LABEL=Free AI model (Groq)
# ASK_EARTH_FREE_AI=off         # disable the free model (offline guide only)

# Limits on AI questions
# ASK_EARTH_RATE_LIMIT=12       # per visitor per 10 minutes
# ASK_EARTH_DAILY_LIMIT=500     # per day (shared across instances when Upstash is configured)

# Optional — shared rate limits across all serverless instances (free Upstash Redis database).
# Without these, each instance keeps its own in-memory counters.
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=

# Optional — protects the daily cloud-map cron job (/api/clouds/warm); Vercel sends it automatically.
# CRON_SECRET=

# Optional — public URL used for link previews (defaults to https://earthscope-climate.vercel.app)
# NEXT_PUBLIC_SITE_URL=
